---
interface Category {
  id: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;

const selectedSelectors = [
  'html[data-catalog-category=""] .category-link[data-category=""]',
  'html[data-catalog-category="latest"] .category-link[data-category="latest"]',
  ...categories.map((category) => `html[data-catalog-category="${category.id}"] .category-link[data-category="${category.id}"]`),
];
const bootstrapCss = `
html[data-catalog-category]:not([data-catalog-category=""]):not([data-catalog-ready]) [data-catalog-grid],
html[data-catalog-category]:not([data-catalog-category=""]):not([data-catalog-ready]) [data-result-count],
html[data-catalog-category]:not([data-catalog-category=""]):not([data-catalog-ready]) [data-load-more] {
  visibility: hidden;
}

${selectedSelectors.join(",\n")} {
  border-left-color: var(--brass-bright);
  background:
    linear-gradient(90deg, var(--legion-highlight), transparent 72%),
    color-mix(in srgb, var(--brass) 28%, var(--ink-soft));
  color: var(--paper);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brass) 36%, transparent);
}

${selectedSelectors.map((selector) => `${selector} strong`).join(",\n")} {
  color: var(--brass-bright);
}
`;
---

<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search);
    var hasUrlState = ["q", "category", "shop", "sort"].some(function (key) {
      return params.has(key);
    });
    var category = "latest";
    if (hasUrlState) {
      category = params.get("category") || "";
    } else {
      try {
        var saved = JSON.parse(sessionStorage.getItem("jt-catalog-state") || "{}");
        category = typeof saved.category === "string" ? saved.category : "latest";
      } catch (error) {}
    }
    document.documentElement.dataset.catalogCategory = category;
  })();
</script>

<style is:global set:html={bootstrapCss}></style>
