---
import catalogJson from "../generated/catalog.json";
import type { CatalogData } from "../types/catalog";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const catalogCount = (catalogJson as CatalogData).productCount;
---

<header class:list={["site-header", { compact }]}>
  <a class="brand" href="/" aria-label="JoyToy Warhammer catalog home">
    <span class="brand-mark" aria-hidden="true">JT</span>
    <span class="brand-copy">
      <span class="eyebrow">Field Archive / 40K</span>
      <span class="brand-name">JoyToy Warhammer</span>
    </span>
  </a>
  <div class="header-actions">
    <span class="edition">Catalog {catalogCount}</span>
    <button class="language-toggle" type="button" data-language-toggle aria-label="Switch language">VI</button>
  </div>
</header>
